# Copy to .env (gitignored) before running the app.
#
# Transcribe reuses the *same* MinIO container job_app runs -- see
# apps/tools-app/docker-compose.yml -- just under a different bucket, so no second
# container is needed. Start it (if it isn't already running) with:
#   cd ../tools-app && docker compose up -d
#
# MINIO_ROOT_USER / MINIO_ROOT_PASSWORD / MINIO_ENDPOINT / MINIO_SECURE must match
# whatever apps/tools-app/.env was set up with, since they're the same container.
MINIO_ROOT_USER=job-app-admin
MINIO_ROOT_PASSWORD=change-me-please
MINIO_ENDPOINT=localhost:9000
MINIO_SECURE=false

# This app's own bucket on that shared container (distinct from job-app's bucket).
TRANSCRIBE_MINIO_BUCKET=transcribe
