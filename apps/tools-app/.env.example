# Copy to .env (gitignored) and fill in real values before running docker compose / the app.

# Credentials for the local MinIO container. Pick your own values -- these are not defaults
# that ship pre-configured anywhere, MinIO creates the root user from whatever is set here.
MINIO_ROOT_USER=job-app-admin
MINIO_ROOT_PASSWORD=change-me-please

# Read by the app (job_app/storage.py) to connect to that same MinIO instance.
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=job-app
MINIO_SECURE=false

# Read by job_app/latex.py. Optional -- defaults to texlive/texlive:latest (several GB; the
# first PDF compile pulls it). Point this at a smaller scheme/tag if you don't need the full
# package set. Requires the docker CLI on PATH, no compose service to start.
# LATEX_DOCKER_IMAGE=texlive/texlive:latest
