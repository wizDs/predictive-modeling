# Copy to .env (gitignored) and fill in real values before running docker compose / the app.

# Credentials for the local MinIO container. Pick your own values -- these are not defaults
# that ship pre-configured anywhere, MinIO creates the root user from whatever is set here.
# This one container is shared by both the Job Application and Transcribe pages (each uses
# its own bucket below) -- see docker-compose.yml.
MINIO_ROOT_USER=job-app-admin
MINIO_ROOT_PASSWORD=change-me-please

# Read by job_app (job_app/storage.py) to connect to that same MinIO instance.
MINIO_ENDPOINT=localhost:9000
MINIO_BUCKET=job-app
MINIO_SECURE=false

# Read by the Transcribe page (../transcribe/storage.py), same container, separate bucket.
TRANSCRIBE_MINIO_BUCKET=transcribe
